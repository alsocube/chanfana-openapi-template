{
	"name": "simplycms",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/index.ts",
	"name": "chanfana-openapi-template",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"vars": {
		"R2_ACCOUNT_ID": "0d8499ecd9b722978540982397cbfedd",
		"R2_BUCKET_NAME": "simplycms"
	},
	"r2_buckets": [
		{
			"binding": "POSTS_BUCKET",
			"bucket_name": "simplycms"
		}
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "5f49b17e773c49deb7f74702546f0111",
			"localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "openapi-template-db",
			"database_id": "752c2af0-14c9-4958-b6e1-60ec24e87439"
		}
	]
}